{
  "name": "flyai-webapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FlyAI 新版前端（React 18 + TS + Rspack），表现层移植自 deepseek-ai/chat-demo (MIT)",
  "scripts": {
    "dev": "rspack serve -c rspack.config.ts",
    "build": "cross-env NODE_ENV=production rspack build -c rspack.config.ts",
    "sync:static": "node sync-static.mjs",
    "deploy": "npm run build && npm run sync:static",
    "type": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@types/katex": "^0.16.8",
    "@types/mdast": "~4.0.3",
    "@types/prismjs": "^1.26.6",
    "clsx": "2.1.1",
    "katex": "^0.16.22",
    "mdast-util-find-and-replace": "^3.0.2",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "mermaid": "^11.10.1",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-llm-math": "^3.1.0",
    "prismjs": "^1.30.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "4.4.7"
  },
  "devDependencies": {
    "@rspack/cli": "2.0.2",
    "@rspack/core": "2.0.2",
    "@rspack/dev-server": "2.0.1",
    "@swc/helpers": "0.5.23",
    "@types/node": "~20.9.2",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "cross-env": "7.0.3",
    "typescript": "~7.0.2",
    "vitest": "^3.2.7"
  }
}
