ue,"depth":1,"outletName":"","group":"","groupOverride":false,"groupWeight":100,"scanDepth":null,"caseSensitive":null,"matchWholeWords":null,"useGroupScoring":null,"automationId":"","role":0,"sticky":0,"cooldown":0,"delay":0,"triggers":[],"displayIndex":4,"characterFilter":{"isExclude":false,"names":[],"tags":[]}},"5":{"uid":5,"key":[],"keysecondary":[],"comment":"防止身份刻板","content":"<nsfw身份去刻板>\n##请去除以下刻板印象：\n - 插入方不都是强势的，根据角色人设可以是温柔、脆弱等多元化性格。\n - 被插入方不都是软弱的，根据角色人设可以是坚韧、冷淡等多元化性格。\n - 主导地位不等于油腻、霸总，只是在性爱中把控节奏。主导者也可以是被插入方，通过言语或行为主导性爱进行。\n<nsfw身份去刻板>","constant":true,"vectorized":false,"selective":true,"selectiveLogic":0,"addMemo":true,"order":100,"position":4,"disable":true,"ignoreBudget":false,"excludeRecursion":true,"preventRecursion":true,"matchPersonaDescription":false,"matchCharacterDescription":false,"matchCharacterPersonality":false,"matchCharacterDepthPrompt":false,"matchScenario":false,"matchCreatorNotes":false,"delayUntilRecursion":false,"probability":100,"useProbability":true,"depth":1,"outletName":"","group":"","groupOverride":false,"groupWeight":100,"scanDepth":null,"caseSensitive":null,"matchWholeWords":null,"useGroupScoring":null,"automationId":"","role":0,"sticky":0,"cooldown":0,"delay":0,"triggers":[],"displayIndex":5,"characterFilter":{"isExclude":false,"names":[],"tags":[]}},"6":{"uid":6,"key":[],"keysecondary":[],"comment":"小腹凸起","content":"<插入凸起描写>\n- 规则：NSFW剧情中，当插入的阴茎或物体较大时，需要详细描写被插入方小腹处被插入的阴茎或物体顶起对应形状的凸起的场景，并结合NSFW剧情中参与角色的视觉、触觉、感受进行详细特写。同时还需根据不同角色对此做出符合角色人设的反应，如调侃、进行dirty talk、安抚、感到惊慌、抚摸凸起处等，角色应在性爱中对各种衍生情况做出自然的互动。\n</插入凸起描写>","constant":true,"vectorized":false,"selective":true,"selectiveLogic":0,"addMemo":true,"order":100,"position":4,"disable":true,"ignoreBudget":false,"excludeRecursion":true,"preventRecursion":true,"matchPersonaDescription":false,"matchCharacterDescription":false,"matchCharacterPersonality":false,"matchCharacterDepthPrompt":false,"matchScenario":false,"matchCreatorNotes":false,"delayUntilRecursion":false,"probability":100,"useProbability":true,"depth":1,"outletName":"","group":"","groupOverride":false,"groupWeight":100,"scanDepth":null,"caseSensitive":null,"matchWholeWords":null,"useGroupScoring":null,"automationId":"","role":0,"sticky":0,"cooldown":0,"delay":0,"triggers":[],"displayIndex":6,"characterFilter":{"isExclude":false,"names":[],"tags":[]}},"7":{"uid":7,"key":[],"keysecondary":[],"comment":"快感强烈表现与互动（翻白眼/流涎水/吐舌/痉挛/失神等）","content":"<快感强烈表现>\n- 规则：在NSFW剧情中，如角色感受到的快感过于强烈、超出平时习惯的阈值，应当描写角色不同往常的快感反应（如翻白眼、因一直张着嘴喘息而流出口水、浑身痉挛发抖、喘息时无意识吐出舌头、意识恍惚的失神状态等一种或多种不冲突的情态交织），这样的反应越不同往常越能体现出角色感受到的快感之剧烈，但需注意必须符合剧情发展。\n- 细化描写：角色在感受到强烈快感时（通常是在高潮后，也可能发生在禁欲后性爱、多次寸止无法达到高潮等特殊情况时），需要详细描述其状态与感受，视觉上的描述可以通过其他参与角色观察的视角或是上帝视角来进行特写描绘，触觉与感受则需切换视角来进行详细描写。\n- 互动反应：当某一角色陷入快感强烈的状态时，通常可以给造成这种状态的角色赋予征服感/兴奋感/心理快感等，其他在场角色也应当对此做出符合自己人设的反应，如体贴地停下安抚或是继续给予更多快感等。\n</快感强烈表现>","constant":true,"vectorized":false,"selective":true,"selectiveLogic":0,"addMemo":true,"order":100,"position":4,"disable":true,"ignoreBudget":false,"excludeRecursion":true,"preventRecursion":true,"matchPersonaDescription":false,"matchCharacterDescription":false,"matchCharacterPersonality":false,"matchCharacterDepthPrompt":false,"matchScenario":false,"matchCreatorNotes":false,"delayUntilRecursion":false,"probability":100,"useProbability":true,"depth":1,"outletName":"","group":"","groupOverride":false,"groupWeight":100,"scanDepth":null,"caseSensitive":null,"matchWholeWords":null,"useGroupScoring":null,"automationId":"","role":0,"sticky":0,"cooldown":0,"delay":0,"triggers":[],"displayIndex":7,"characterFilter":{"isExclude":false,"names":[],"tags":[]}},"8":{"uid":8,"key":[],"keysecondary":[],"comment":"更好的亲吻（接吻指导与氛围匹配）","content":"<接吻指导>\n ##亲密关系中的亲吻必不可少，关于亲吻的描写需遵循以下规则：\n1. 亲吻的多样性：亲吻的类型、姿势是多样的，需要根据场景与角色动作设计合适的亲吻剧情。\n2. 亲吻根据氛围不同可以带来愉悦、兴奋、性冲动与安抚等多种作用。\n3. 描写指导：需重点描写亲吻时角色的感受与表现，以及亲吻时舌头舔舐、搅动的状态以及唇部与被亲吻部位的细节刻画，如深吻时舌尖交缠、分开后口水拉丝滴落等特征。\n4. 恰当氛围：描写时需结合当前角色情绪赋予亲吻描写恰当的氛围，如久别重逢后的亲吻对应激动怀念的氛围、怨侣打架后互不相让的亲吻对应爱恨交织的氛围、第一次确认关系的亲吻对应忐忑欣喜的氛围、做爱时的亲吻对应色情黏腻的氛围等，请对当前剧情做出分析后再加入恰当的氛围。\n\n<